# PORT: HTTP and WebSocket server port (default: 3000)
PORT="3000"

# APP_URL: Public URL where Rahhala is hosted (injected automatically in AI Studio)
APP_URL="http://localhost:3000"

# RAHHALA_DB_PATH: SQLite database file path
RAHHALA_DB_PATH="./data/rahhala.db"

# RAHHALA_INSTITUTION_SUBTITLE: Configurable institution subtitle shown in branding
RAHHALA_INSTITUTION_SUBTITLE="كلية الدعوة الإسلامية - الأزهر الشريف"

# RAHHALA_MEETING_PROVIDER_URL: Optional external meeting provider base URL (e.g. Jitsi/self-hosted room URL)
# Leave empty to use built-in browser WebRTC room or configure via Admin Settings
RAHHALA_MEETING_PROVIDER_URL=""

# RAHHALA_PREVIEW_DEMO: Set to "true" ONLY in local development to seed fictional demo accounts
# Never enable in production; production owner initialization uses `npm run init-owner`
RAHHALA_PREVIEW_DEMO="false"
